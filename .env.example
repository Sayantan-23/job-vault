# JobVault — repo-root environment. THE single source of truth.
#
#   make setup        # copies this file to .env (never overwrites an existing one)
#
# Why one file at the root instead of one per app:
#   Under Docker, *compose* sets the environment, and compose only reads variable
#   interpolation (${VAR}) from the .env sitting next to docker-compose.yml — it
#   never looks inside backend-express/ or frontend-next/. If an app ALSO loaded
#   its own .env, you would have two setters, and the inner one always loses:
#   dotenv and Next both refuse to overwrite a variable already in process.env.
#   That failure is silent. So: values live here, and here only. The per-app
#   .env.example files document what each app consumes; they are not loaded.
#
# This file is committed. Never put a real secret in it — put those in .env,
# which is gitignored.

# --- Host ports -------------------------------------------------------------
# 5432/3000 are usually taken on this machine, hence the remap. Keep
# DB_PORT_EXTERNAL and the DATABASE_URL port below in sync.
DB_PORT_EXTERNAL=5433
BACKEND_PORT=3100
FRONTEND_PORT=8080

# --- Postgres ---------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobvault

# --- Auth -------------------------------------------------------------------
# Must be >= 32 chars. Changing it invalidates every existing session.
JWT_SECRET=change-me-to-a-32-char-dev-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Backend, host-run only -------------------------------------------------
# Inside Docker compose overrides both (the DB is reachable as `postgres:5432`
# and the browser origin is fixed). These values are for `npm run db:seed`,
# drizzle-kit, and a host-run `npm run dev` from backend-express/.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jobvault
CORS_ORIGINS=http://localhost:8080

# --- Logging / feature toggles ----------------------------------------------
LOG_LEVEL=info
ENABLE_SCHEDULER=true
ENABLE_REALTIME=true

# --- AI (Gemini) ------------------------------------------------------------
# Powers résumé generation, cover letters, résumé import and scraper cleanup.
# Blank leaves every AI feature off: GET /api/ai/status returns enabled:false
# and the personas page shows "AI features are not configured".
# Written as ${GEMINI_API_KEY} (no default) in docker-compose.yml on purpose, so
# an unset key makes compose WARN instead of silently disabling AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- URL scraper render fallback --------------------------------------------
# For JS-rendered / bot-protected boards. Jina Reader works with no key;
# JINA_API_KEY only raises the rate limit.
SCRAPER_RENDER_ENABLED=true
JINA_API_KEY=

# --- Deferred integrations (not wired up yet) -------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Demo seed (npm run db:seed / make seed) --------------------------------
SEED_EMAIL=demo@jobvault.app
SEED_PASSWORD=demo1234
