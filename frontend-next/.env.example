# frontend-next — local host runs only.
#
# Real values live in the repo-root .env (`make setup`), which compose feeds to
# the container. Next.js can only auto-load env files from its own directory, so
# if you run `npm run dev` here on the HOST (outside Docker), copy this file to
# .env.local. Under Docker it is unnecessary and unused.
#
# This is the one deliberate exception to "root .env only" — and it holds no
# secrets, just the API base URL.

NEXT_PUBLIC_API_BASE=http://localhost:3000

NODE_ENV=development
