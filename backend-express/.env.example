# backend-express — REFERENCE ONLY. This file is not loaded by anything.
#
# Real values live in the repo-root .env (`make setup` creates it from
# /.env.example). The backend loads that file via src/config/load-dotenv.ts, and
# inside Docker compose supplies the environment directly. Keeping a second .env
# here would silently shadow the root one, because dotenv never overwrites a
# variable that already exists in process.env.
#
# This file documents what the backend consumes; add new vars to /.env.example.

NODE_ENV=development
PORT=3000
# Comma-separated allowlist. The Chrome extension's popup/service-worker calls
# reach the backend via the manifest's host_permissions and bypass CORS, so the
# extension origin normally need NOT be listed here. If you ever see a CORS block
# on /api/extension/*, add the pinned origin: chrome-extension://<extension-id>
CORS_ORIGINS=http://localhost:8080

# Database (compose into a single URL — used by Drizzle and pg)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobvault

# JWT (at least 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=replace-me-with-32-plus-character-random-string-please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (optional in Phase 0; required in Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudinary (optional until Phase 6)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (optional until Phase 6)
GEMINI_API_KEY=
# Optional fallback model: retried once when the primary GEMINI_MODEL fails
# transiently (timeout or 503 overload). Leave unset to disable the fallback.
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Logging
LOG_LEVEL=info
